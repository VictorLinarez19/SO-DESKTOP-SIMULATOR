{
  "name": "guinan-os",
  "productName": "guiñanOS",
  "version": "0.1.0",
  "description": "guiñanOS: simulador de sistema operativo de escritorio con administración de recursos y hardware real",
  "main": "./out/main/index.js",
  "author": "juan",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev --noSandbox",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview --noSandbox",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx scripts/sim-cli.ts",
    "dist": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "framer-motion": "^14.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "mx.guinanos.app",
    "productName": "guiñanOS",
    "artifactName": "guinanOS-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "System",
      "maintainer": "juan",
      "synopsis": "Simulador de sistema operativo de escritorio"
    }
  }
}
